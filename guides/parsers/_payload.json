,[147,148,149,150,152],"strong",{},"each complete frame is exactly one ",[130,151,140],{}," call",", sent as soon as it is\ncomplete (the batch window no longer applies).",[155,156,161],"pre",{"className":157,"code":158,"language":159,"meta":160,"style":160},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","await port.watch(\n  { onData: (line) => console.log(\"line:\", line) },\n  { parser: { type: \"readline\", delimiter: \"\\r\\n\" } },\n);\n\n\u002F\u002F Binary packets: keep bytes, one Uint8Array per packet.\nawait port.watch(\n  { onData: (frame) => handle(frame as Uint8Array) },\n  { decode: false, parser: { type: \"startEnd\", startDelimiter: [0x02], endDelimiter: [0x03] } },\n);\n","ts","",[130,162,163,187,241,288,296,303,310,323,359,429],{"__ignoreMap":160},[164,165,168,172,176,180,184],"span",{"class":166,"line":167},"line",1,[164,169,171],{"class":170},"s7zQu","await",[164,173,175],{"class":174},"sTEyZ"," port",[164,177,179],{"class":178},"sMK4o",".",[164,181,183],{"class":182},"s2Zo4","watch",[164,185,186],{"class":174},"(\n",[164,188,190,193,196,199,202,205,208,212,215,217,220,223,226,230,232,235,238],{"class":166,"line":189},2,[164,191,192],{"class":178},"  {",[164,194,195],{"class":182}," onData",[164,197,198],{"class":178},":",[164,200,201],{"class":178}," (",[164,203,166],{"class":204},"sHdIc",[164,206,207],{"class":178},")",[164,209,211],{"class":210},"spNyl"," =>",[164,213,214],{"class":174}," console",[164,216,179],{"class":178},[164,218,219],{"class":182},"log",[164,221,222],{"class":174},"(",[164,224,225],{"class":178},"\"",[164,227,229],{"class":228},"sfazB","line:",[164,231,225],{"class":178},[164,233,234],{"class":178},",",[164,236,237],{"class":174}," line) ",[164,239,240],{"class":178},"},\n",[164,242,244,246,250,252,255,258,260,263,266,268,270,273,275,277,280,282,285],{"class":166,"line":243},3,[164,245,192],{"class":178},[164,247,249],{"class":248},"swJcz"," parser",[164,251,198],{"class":178},[164,253,254],{"class":178}," {",[164,256,257],{"class":248}," type",[164,259,198],{"class":178},[164,261,262],{"class":178}," \"",[164,264,265],{"class":228},"readline",[164,267,225],{"class":178},[164,269,234],{"class":178},[164,271,272],{"class":248}," delimiter",[164,274,198],{"class":178},[164,276,262],{"class":178},[164,278,279],{"class":174},"\\r\\n",[164,281,225],{"class":178},[164,283,284],{"class":178}," }",[164,286,287],{"class":178}," },\n",[164,289,291,293],{"class":166,"line":290},4,[164,292,207],{"class":174},[164,294,295],{"class":178},";\n",[164,297,299],{"class":166,"line":298},5,[164,300,302],{"emptyLinePlaceholder":301},true,"\n",[164,304,306],{"class":166,"line":305},6,[164,307,309],{"class":308},"sHwdD","\u002F\u002F Binary packets: keep bytes, one Uint8Array per packet.\n",[164,311,313,315,317,319,321],{"class":166,"line":312},7,[164,314,171],{"class":170},[164,316,175],{"class":174},[164,318,179],{"class":178},[164,320,183],{"class":182},[164,322,186],{"class":174},[164,324,326,328,330,332,334,337,339,341,344,347,350,354,357],{"class":166,"line":325},8,[164,327,192],{"class":178},[164,329,195],{"class":182},[164,331,198],{"class":178},[164,333,201],{"class":178},[164,335,336],{"class":204},"frame",[164,338,207],{"class":178},[164,340,211],{"class":210},[164,342,343],{"class":182}," handle",[164,345,346],{"class":174},"(frame ",[164,348,349],{"class":170},"as",[164,351,353],{"class":352},"sBMFI"," Uint8Array",[164,355,356],{"class":174},") ",[164,358,240],{"class":178},[164,360,362,364,367,369,373,375,377,379,381,383,385,387,390,392,394,397,399,402,406,409,411,414,416,418,421,424,427],{"class":166,"line":361},9,[164,363,192],{"class":178},[164,365,366],{"class":248}," decode",[164,368,198],{"class":178},[164,370,372],{"class":371},"sfNiH"," false",[164,374,234],{"class":178},[164,376,249],{"class":248},[164,378,198],{"class":178},[164,380,254],{"class":178},[164,382,257],{"class":248},[164,384,198],{"class":178},[164,386,262],{"class":178},[164,388,389],{"class":228},"startEnd",[164,391,225],{"class":178},[164,393,234],{"class":178},[164,395,396],{"class":248}," startDelimiter",[164,398,198],{"class":178},[164,400,401],{"class":174}," [",[164,403,405],{"class":404},"sbssI","0x02",[164,407,408],{"class":174},"]",[164,410,234],{"class":178},[164,412,413],{"class":248}," endDelimiter",[164,415,198],{"class":178},[164,417,401],{"class":174},[164,419,420],{"class":404},"0x03",[164,422,423],{"class":174},"] ",[164,425,426],{"class":178},"}",[164,428,287],{"class":178},[164,430,432,434],{"class":166,"line":431},10,[164,433,207],{"class":174},[164,435,295],{"class":178},[126,437,438,439,442,443,446],{},"The parsers follow the Node.js ",[130,440,441],{},"@serialport\u002Fparser-*"," packages (their test suites\nare ported to Rust in the ",[130,444,445],{},"serial-codec"," crate), so code written for Node\nserialport maps over directly.",[448,449,451],"h2",{"id":450},"parser-types","Parser types",[126,453,454,455,458,459,462,463,466,467,470],{},"Byte sequences (",[130,456,457],{},"ByteSeq",") are a UTF-8 string, a ",[130,460,461],{},"number[]"," or a ",[130,464,465],{},"Uint8Array",".\n",[130,468,469],{},"maxBufferSize"," defaults to 65536 bytes.",[472,473,474,495],"table",{},[475,476,477],"thead",{},[478,479,480,486,489,492],"tr",{},[481,482,483],"th",{},[130,484,485],{},"type",[481,487,488],{},"Node package",[481,490,491],{},"Options",[481,493,494],{},"Frame",[496,497,498,526,549,573,603,640,660,682,712,750],"tbody",{},[478,499,500,506,511,523],{},[501,502,503],"td",{},[130,504,505],{},"delimiter",[501,507,508],{},[130,509,510],{},"parser-delimiter",[501,512,513,516,517,520,521],{},[130,514,515],{},"delimiter: ByteSeq"," (required), ",[130,518,519],{},"includeDelimiter = false",", ",[130,522,469],{},[501,524,525],{},"Bytes up to each delimiter",[478,527,528,532,537,546],{},[501,529,530],{},[130,531,265],{},[501,533,534],{},[130,535,536],{},"parser-readline",[501,538,539,520,542,520,544],{},[130,540,541],{},"delimiter: ByteSeq = \"\\n\"",[130,543,519],{},[130,545,469],{},[501,547,548],{},"One line",[478,550,551,556,561,567],{},[501,552,553],{},[130,554,555],{},"byteLength",[501,557,558],{},[130,559,560],{},"parser-byte-length",[501,562,563,566],{},[130,564,565],{},"length"," (> 0)",[501,568,569,570,572],{},"Exactly ",[130,571,565],{}," bytes",[478,574,575,580,585,597],{},[501,576,577],{},[130,578,579],{},"interByteTimeout",[501,581,582],{},[130,583,584],{},"parser-inter-byte-timeout",[501,586,587,590,591,594,595],{},[130,588,589],{},"intervalMs"," (alias ",[130,592,593],{},"interval",", > 0), ",[130,596,469],{},[501,598,599,600,602],{},"Everything received before ",[130,601,589],{}," of silence",[478,604,605,610,615,637],{},[501,606,607],{},[130,608,609],{},"packetLength",[501,611,612],{},[130,613,614],{},"parser-packet-length",[501,616,617,520,620,623,624,520,627,630,631,520,634],{},[130,618,619],{},"delimiter: number | number[] = 0xaa",[130,621,622],{},"delimiterBytes = 1"," (1–4), ",[130,625,626],{},"packetOverhead = 2",[130,628,629],{},"lengthBytes = 1"," (1–8), ",[130,632,633],{},"lengthOffset = 1",[130,635,636],{},"maxLen = 0xff",[501,638,639],{},"Delimiter + little-endian length field + payload",[478,641,642,647,652,657],{},[501,643,644],{},[130,645,646],{},"ready",[501,648,649],{},[130,650,651],{},"parser-ready",[501,653,654,656],{},[130,655,515],{}," (required)",[501,658,659],{},"Nothing until the marker, then data passes through as it arrives",[478,661,662,667,672,679],{},[501,663,664],{},[130,665,666],{},"regex",[501,668,669],{},[130,670,671],{},"parser-regex",[501,673,674,516,677],{},[130,675,676],{},"regex: string",[130,678,469],{},[501,680,681],{},"UTF-8 text between matches",[478,683,684,688,693,709],{},[501,685,686],{},[130,687,389],{},[501,689,690],{},[130,691,692],{},"parser-start-end",[501,694,695,520,698,516,701,520,704,520,707],{},[130,696,697],{},"startDelimiter",[130,699,700],{},"endDelimiter",[130,702,703],{},"includeStartDelimiter = false",[130,705,706],{},"includeEndDelimiter = false",[130,708,469],{},[501,710,711],{},"Bytes between the markers",[478,713,714,719,727,747],{},[501,715,716],{},[130,717,718],{},"slip",[501,720,721,201,724,207],{},[130,722,723],{},"parser-slip-encoder",[130,725,726],{},"SlipDecoder",[501,728,729,520,732,520,735,520,738,520,741,520,744],{},[130,730,731],{},"start",[130,733,734],{},"esc = 0xdb",[130,736,737],{},"end = 0xc0",[130,739,740],{},"escStart",[130,742,743],{},"escEnd = 0xdc",[130,745,746],{},"escEsc = 0xdd",[501,748,749],{},"One decoded SLIP (RFC 1055) packet",[478,751,752,757,762,768],{},[501,753,754],{},[130,755,756],{},"ccTalk",[501,758,759],{},[130,760,761],{},"parser-cctalk",[501,763,764,767],{},[130,765,766],{},"maxDelayMs = 50"," (0 disables)",[501,769,770,771],{},"One ccTalk message (length in byte 1); a partial message is dropped after ",[130,772,773],{},"maxDelayMs",[126,775,776,777,780,781,783,784,787],{},"An invalid configuration (empty delimiter, ",[130,778,779],{},"length: 0",", a bad regex, …) rejects\n",[130,782,132],{}," with ",[130,785,786],{},"invalid parser options: …"," before the watch starts.",[448,789,791],{"id":790},"behaviour","Behaviour",[793,794,795,814,829,848,877,883,906],"ul",{},[796,797,798,801,802,805,806,809,810,813],"li",{},[147,799,800],{},"Decoding."," With ",[130,803,804],{},"decode: true"," (default) every frame is decoded on its own\nwith the port ",[130,807,808],{},"encoding",", so one frame is always one string. Use ",[130,811,812],{},"decode: false","\nfor binary frames.",[796,815,816,819,820,822,823,825,826,828],{},[147,817,818],{},"Time-based parser."," ",[130,821,579],{}," is driven by the native read loop: a\nframe is emitted when the silence elapses, even if no further bytes arrive.\n",[130,824,756],{}," never emits on time; it drops a stale partial message (older than\n",[130,827,773],{},") when the next byte arrives.",[796,830,831,801,834,837,838,841,842,844,845,847],{},[147,832,833],{},"URC routing.",[130,835,836],{},"routeUrc"," (on by default when ",[130,839,840],{},"onUrc"," is given), AT URC\nlines are split off first and go to ",[130,843,840],{},"; only the remaining lines reach the\nparser. An unterminated line is handed to the parser on the batch timer, the same\nway it reaches ",[130,846,140],{}," without a parser.",[796,849,850,853,854,520,857,860,861,863,864,867,868,870,871,873,874,876],{},[147,851,852],{},"End of stream."," On ",[130,855,856],{},"unwatch()",[130,858,859],{},"close()"," or a disconnect, the parser's buffered\npartial frame (if any) is delivered as a last ",[130,862,140],{}," call, before\n",[130,865,866],{},"onDisconnect",". Node emits it the same way when the stream ends. ",[130,869,646],{}," and\n",[130,872,756],{}," have nothing to flush; ",[130,875,609],{}," flushes only a started packet.",[796,878,879,882],{},[147,880,881],{},"Auto-reconnect"," re-creates the watch with the same parser (and a fresh,\nempty buffer).",[796,884,885,201,888,891,892,894,895,897,898,900,901,903,904,179],{},[147,886,887],{},"CMUX channels",[130,889,890],{},"openMuxChannel()",") take the same ",[130,893,144],{}," option, but a\nchannel watch ignores ",[130,896,836],{}," and ",[130,899,136],{},": URC lines on a channel are not split\noff to ",[130,902,840],{},", and batches are not flushed early at ",[130,905,136],{},[796,907,908],{},"Empty frames are never emitted.",[448,910,912],{"id":911},"differences-from-node-serialport","Differences from Node serialport",[793,914,915,938,960,975,986,1011],{},[796,916,917,920,921,520,923,520,925,520,927,897,929,931,932,934,935,937],{},[147,918,919],{},"Buffers are bounded."," A stream that never completes a frame cannot grow memory\nforever: ",[130,922,505],{},[130,924,265],{},[130,926,666],{},[130,928,579],{},[130,930,718],{}," emit the\nfull buffer as a frame at ",[130,933,469],{},"; ",[130,936,389],{}," drops the overlong open frame\n(keeping a later start marker).",[796,939,940,943,944,946,947,949,950,952,953,956,957,959],{},[147,941,942],{},"Frames are bytes."," Node's ",[130,945,808],{}," option on ",[130,948,265],{}," \u002F ",[130,951,666],{}," only\nchanges how Node renders a frame; here ",[130,954,955],{},"decode"," and the port ",[130,958,808],{}," do that.",[796,961,962,966,967,970,971,974],{},[147,963,964],{},[130,965,646],{}," finds its marker after a false start (",[130,968,969],{},"\"RREADY\""," matches ",[130,972,973],{},"\"READY\"",";\nNode misses it).",[796,976,977,981,982,985],{},[147,978,979],{},[130,980,609],{}," finds a multi-byte delimiter anywhere in the stream (Node only\nfinds it at stream start or right after a packet). At end of stream only a started\npacket is flushed. A packet also ends once it is at least ",[130,983,984],{},"len + packetOverhead","\nlong, so a header longer than that cannot buffer forever.",[796,987,988,992,993,1002,1003,1006,1007,1010],{},[147,989,990],{},[130,991,666],{}," keeps a UTF-8 character split across reads for the next chunk (Node\nturns it into U+FFFD). The pattern uses Rust\n",[994,995,999],"a",{"href":996,"rel":997},"https:\u002F\u002Fdocs.rs\u002Fregex-lite",[998],"nofollow",[130,1000,1001],{},"regex-lite"," syntax as a string, not a JavaScript\n",[130,1004,1005],{},"RegExp",", and capture groups are not spliced into the output the way\n",[130,1008,1009],{},"String.split"," does.",[796,1012,1013,1016],{},[147,1014,1015],{},"Timers"," come from the native read loop (about 10 ms granularity) instead of\nJavaScript timers.",[448,1018,42],{"id":1019},"rust",[126,1021,1022,1023,1029,1030,1033,1034,1037,1038,1041,1042,949,1045,179],{},"The same parsers are available without the plugin in the\n",[994,1024,1027],{"href":1025,"rel":1026},"https:\u002F\u002Fdocs.rs\u002Fserial-codec",[998],[130,1028,445],{}," crate (",[130,1031,1032],{},"serial_codec::framing",":\n",[130,1035,1036],{},"FramerConfig::build()"," and the ",[130,1039,1040],{},"Framer"," trait), and from Rust through\n",[130,1043,1044],{},"SerialPort::watch_framed",[130,1046,1047],{