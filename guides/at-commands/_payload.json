 on the wire, and a ",[126,142,143],{},"watch()"," can stay\nactive the whole time to receive unsolicited lines.",[146,147,149],"h2",{"id":148},"sendat",[126,150,132],{},[152,153,158],"pre",{"className":154,"code":155,"language":156,"meta":157,"style":157},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","const r = await port.sendAt(\"AT+CSQ\");\n\u002F\u002F r.status: \"ok\" | \"error\" | \"cme\" | \"cms\" | \"unknown\"\n\u002F\u002F r.lines:  [\"AT+CSQ\", \"+CSQ: 27,0\", \"OK\"]\n\u002F\u002F r.solicitedBody: [\"+CSQ: 27,0\"]   r.urcLines: []   r.raw: Uint8Array\n","ts","",[126,159,160,209,216,222],{"__ignoreMap":157},[161,162,165,169,173,177,181,184,187,191,194,197,201,203,206],"span",{"class":163,"line":164},"line",1,[161,166,168],{"class":167},"spNyl","const",[161,170,172],{"class":171},"sTEyZ"," r ",[161,174,176],{"class":175},"sMK4o","=",[161,178,180],{"class":179},"s7zQu"," await",[161,182,183],{"class":171}," port",[161,185,186],{"class":175},".",[161,188,190],{"class":189},"s2Zo4","sendAt",[161,192,193],{"class":171},"(",[161,195,196],{"class":175},"\"",[161,198,200],{"class":199},"sfazB","AT+CSQ",[161,202,196],{"class":175},[161,204,205],{"class":171},")",[161,207,208],{"class":175},";\n",[161,210,212],{"class":163,"line":211},2,[161,213,215],{"class":214},"sHwdD","\u002F\u002F r.status: \"ok\" | \"error\" | \"cme\" | \"cms\" | \"unknown\"\n",[161,217,219],{"class":163,"line":218},3,[161,220,221],{"class":214},"\u002F\u002F r.lines:  [\"AT+CSQ\", \"+CSQ: 27,0\", \"OK\"]\n",[161,223,225],{"class":163,"line":224},4,[161,226,227],{"class":214},"\u002F\u002F r.solicitedBody: [\"+CSQ: 27,0\"]   r.urcLines: []   r.raw: Uint8Array\n",[122,229,230,231,129,234,237,238,129,241,129,244,129,247,129,250,237,253,129,256,129,259,262,263,265],{},"A command is complete when its final result line arrives: ",[126,232,233],{},"OK",[126,235,236],{},"ERROR",",\n",[126,239,240],{},"+CME ERROR: n",[126,242,243],{},"+CMS ERROR: n",[126,245,246],{},"NO CARRIER",[126,248,249],{},"BUSY",[126,251,252],{},"NO ANSWER",[126,254,255],{},"NO DIALTONE",[126,257,258],{},"SEND OK",[126,260,261],{},"SEND FAIL",". URCs that arrive in the same read (before\nthe echo, inside the reply, or right after ",[126,264,233],{},") are reported separately and do\nnot end the command early.",[122,267,268,271,272,129,275,129,278,129,281,129,284,237,287,129,290,129,293,129,296,299,300,302,303,306,307,309,310,312,313,316,317,320],{},[126,269,270],{},"AtCommandResult",": ",[126,273,274],{},"command",[126,276,277],{},"response",[126,279,280],{},"status",[126,282,283],{},"lines",[126,285,286],{},"solicitedBody",[126,288,289],{},"urcLines",[126,291,292],{},"matched",[126,294,295],{},"timedOut",[126,297,298],{},"raw",". ",[126,301,295],{}," is ",[126,304,305],{},"true"," only when the\nexchange itself timed out (a ",[126,308,135],{}," \u002F ",[126,311,139],{}," phase with\n",[126,314,315],{},"stopOnError: false","); a modem error reply such as ",[126,318,319],{},"+CME ERROR: network timeout","\nis an answer, not a timeout.",[122,322,323,326,327,129,330,333,334,337,338,341,342,345,346,129,349,129,352,237,355,129,358,129,361,186],{},[126,324,325],{},"AtCommandOptions"," (per call): ",[126,328,329],{},"timeoutMs",[126,331,332],{},"resultFormat"," (",[126,335,336],{},"\"verbose\""," or\n",[126,339,340],{},"\"numeric\""," for ",[126,343,344],{},"ATV0","), ",[126,347,348],{},"completionMode",[126,350,351],{},"solicitedPrefixes",[126,353,354],{},"rxPrepare",[126,356,357],{},"appendCr",[126,359,360],{},"terminators",[126,362,363],{},"idleMs",[122,365,366,369,370,372,373,376,377,379,380,383,384,129,387,129,390,129,393,129,396,399,400,402],{},[126,367,368],{},"\\r"," is appended unless the command already ends with CR\u002FLF or ",[126,371,357],{}," is\n",[126,374,375],{},"false",". Solicited prefixes are derived from the command (",[126,378,200],{}," → ",[126,381,382],{},"+CSQ:",",\nalso ",[126,385,386],{},"^",[126,388,389],{},"#",[126,391,392],{},"$",[126,394,395],{},"%",[126,397,398],{},"*"," vendor prefixes); pass ",[126,401,351],{}," when the\nreply uses a different one.",[146,404,406],{"id":405},"session-defaults","Session defaults",[152,408,410],{"className":154,"code":409,"language":156,"meta":157,"style":157},"await port.configureAtSession({\n  defaultTimeoutMs: 5000,\n  expectOk: true,      \u002F\u002F reject when status is not \"ok\"\n  stopOnError: true,   \u002F\u002F sendAtPhases: stop at the first failing phase\n  appendCr: true,\n  resultFormat: \"verbose\",\n});\n",[126,411,412,429,444,461,475,487,505],{"__ignoreMap":157},[161,413,414,417,419,421,424,426],{"class":163,"line":164},[161,415,416],{"class":179},"await",[161,418,183],{"class":171},[161,420,186],{"class":175},[161,422,423],{"class":189},"configureAtSession",[161,425,193],{"class":171},[161,427,428],{"class":175},"{\n",[161,430,431,435,438,442],{"class":163,"line":211},[161,432,434],{"class":433},"swJcz","  defaultTimeoutMs",[161,436,437],{"class":175},":",[161,439,441],{"class":440},"sbssI"," 5000",[161,443,237],{"class":175},[161,445,446,449,451,455,458],{"class":163,"line":218},[161,447,448],{"class":433},"  expectOk",[161,450,437],{"class":175},[161,452,454],{"class":453},"sfNiH"," true",[161,456,457],{"class":175},",",[161,459,460],{"class":214},"      \u002F\u002F reject when status is not \"ok\"\n",[161,462,463,466,468,470,472],{"class":163,"line":224},[161,464,465],{"class":433},"  stopOnError",[161,467,437],{"class":175},[161,469,454],{"class":453},[161,471,457],{"class":175},[161,473,474],{"class":214},"   \u002F\u002F sendAtPhases: stop at the first failing phase\n",[161,476,478,481,483,485],{"class":163,"line":477},5,[161,479,480],{"class":433},"  appendCr",[161,482,437],{"class":175},[161,484,454],{"class":453},[161,486,237],{"class":175},[161,488,490,493,495,498,501,503],{"class":163,"line":489},6,[161,491,492],{"class":433},"  resultFormat",[161,494,437],{"class":175},[161,496,497],{"class":175}," \"",[161,499,500],{"class":199},"verbose",[161,502,196],{"class":175},[161,504,237],{"class":175},[161,506,508,511,513],{"class":163,"line":507},7,[161,509,510],{"class":175},"}",[161,512,205],{"class":171},[161,514,208],{"class":175},[122,516,517,518,521,522,186],{},"Pass the same object as ",[126,519,520],{},"atSession"," to the constructor to apply it on every\n",[126,523,524],{},"open()",[122,526,527,528,531,532,535,536,539],{},"Before each command the queue soft-drains stale input (",[126,529,530],{},"rxPrepare: \"drain\"",", the\ndefault): bytes left from an earlier timed-out reply are discarded, URCs in them\nare still emitted. Use ",[126,533,534],{},"\"purge\""," to drop the OS buffers too, or ",[126,537,538],{},"\"none\""," to keep\neverything.",[146,541,543],{"id":542},"multi-phase-commands-and-sms","Multi-phase commands and SMS",[122,545,546,548,549,552],{},[126,547,135],{}," runs several writes as one queue job, so nothing else can slip\nin between (for example between ",[126,550,551],{},"AT+CMGS"," and the PDU):",[152,554,556],{"className":154,"code":555,"language":156,"meta":157,"style":157},"const results = await port.sendAtPhases([\n  { write: \"AT+CMGS=23\", completionMode: \"atIntermediate\" }, \u002F\u002F waits for \"> \"\n  { write: pduBytes \u002F* Uint8Array incl. Ctrl+Z *\u002F },\n]);\n",[126,557,558,579,616,633],{"__ignoreMap":157},[161,559,560,562,565,567,569,571,573,576],{"class":163,"line":164},[161,561,168],{"class":167},[161,563,564],{"class":171}," results ",[161,566,176],{"class":175},[161,568,180],{"class":179},[161,570,183],{"class":171},[161,572,186],{"class":175},[161,574,575],{"class":189},"sendAtPhases",[161,577,578],{"class":171},"([\n",[161,580,581,584,587,589,591,594,596,598,601,603,605,608,610,613],{"class":163,"line":211},[161,582,583],{"class":175},"  {",[161,585,586],{"class":433}," write",[161,588,437],{"class":175},[161,590,497],{"class":175},[161,592,593],{"class":199},"AT+CMGS=23",[161,595,196],{"class":175},[161,597,457],{"