ubstring\"",[701,735,736,737,739],{},"One of ",[126,738,360],{}," appears anywhere",[122,741,742,743,745,746,749,750,752,753,333,756,129,758,129,760,129,762,237,764,129,766,768],{},"Plus ",[126,744,363],{}," (done after this much silence), ",[126,747,748],{},"maxBytes"," and ",[126,751,329],{},".\nThe result is an ",[126,754,755],{},"ExchangeResponse",[126,757,298],{},[126,759,292],{},[126,761,280],{},[126,763,283],{},[126,765,286],{},[126,767,289],{},").",[146,770,772],{"id":771},"cancelling","Cancelling",[122,774,775,778,779,782,783,786,787,790,791,309,793,795],{},[126,776,777],{},"cancelExchange()"," (alias ",[126,780,781],{},"cancelAt()",") fails the running job with\n",[126,784,785],{},"exchange cancelled",", rejects every queued job with\n",[126,788,789],{},"transaction queue cancelled",", and leaves the queue ready for the next call: a\ncall made after the cancel still waits until the cancelled job has returned. A\ncancel that lands between the phases of ",[126,792,135],{},[126,794,139],{}," stops\nthe remaining phases.",[146,797,799],{"id":798},"urcs-while-commands-run","URCs while commands run",[122,801,802,803,806],{},"Keep a watch with ",[126,804,805],{},"onUrc"," to get unsolicited lines live, including the ones\nthat arrive while a command is in flight:",[152,808,810],{"className":154,"code":809,"language":156,"meta":157,"style":157},"await port.watch({\n  onData: () => {},\n  onUrc: (line) => console.log(\"URC\", line), \u002F\u002F +CMTI: \"SM\",3 \u002F RING \u002F +CREG: 1\n});\nawait port.sendAt(\"AT+CSQ\"); \u002F\u002F the watch keeps running\n",[126,811,812,827,843,886,894],{"__ignoreMap":157},[161,813,814,816,818,820,823,825],{"class":163,"line":164},[161,815,416],{"class":179},[161,817,183],{"class":171},[161,819,186],{"class":175},[161,821,822],{"class":189},"watch",[161,824,193],{"class":171},[161,826,428],{"class":175},[161,828,829,832,834,837,840],{"class":163,"line":211},[161,830,831],{"class":189},"  onData",[161,833,437],{"class":175},[161,835,836],{"class":175}," ()",[161,838,839],{"class":167}," =>",[161,841,842],{"class":175}," {},\n",[161,844,845,848,850,852,855,857,859,862,864,867,869,871,874,876,878,881,883],{"class":163,"line":218},[161,846,847],{"class":189},"  onUrc",[161,849,437],{"class":175},[161,851,333],{"class":175},[161,853,163],{"class":854},"sHdIc",[161,856,205],{"class":175},[161,858,839],{"class":167},[161,860,861],{"class":171}," console",[161,863,186],{"class":175},[161,865,866],{"class":189},"log",[161,868,193],{"class":171},[161,870,196],{"class":175},[161,872,873],{"class":199},"URC",[161,875,196],{"class":175},[161,877,457],{"class":175},[161,879,880],{"class":171}," line)",[161,882,457],{"class":175},[161,884,885],{"class":214}," \u002F\u002F +CMTI: \"SM\",3 \u002F RING \u002F +CREG: 1\n",[161,887,888,890,892],{"class":163,"line":224},[161,889,510],{"class":175},[161,891,205],{"class":171},[161,893,208],{"class":175},[161,895,896,898,900,902,904,906,908,910,912,914,917],{"class":163,"line":477},[161,897,416],{"class":179},[161,899,183],{"class":171},[161,901,186],{"class":175},[161,903,190],{"class":189},[161,905,193],{"class":171},[161,907,196],{"class":175},[161,909,200],{"class":199},[161,911,196],{"class":175},[161,913,205],{"class":171},[161,915,916],{"class":175},";",[161,918,919],{"class":214}," \u002F\u002F the watch keeps running\n",[146,921,923],{"id":922},"cmux-gsm-0710-3gpp-27010","CMUX (GSM 07.10 \u002F 3GPP 27.010)",[122,925,926,927,930],{},"CMUX splits one modem port into several logical channels (for example AT\ncommands on one, PPP data on another). The plugin speaks the basic option of\n27.010: ",[126,928,929],{},"AT+CMUX=0",", SABM\u002FUA per channel, CLD on teardown.",[152,932,934],{"className":154,"code":933,"language":156,"meta":157,"style":157},"await port.enableMux();                       \u002F\u002F sends AT+CMUX=0,0,5,31,10,2 and opens DLCI 0\nconst at = await port.openMuxChannel(1);      \u002F\u002F a SerialPort for DLCI 1 (1..=63)\nconst data = await port.openMuxChannel(2);\nawait at.sendAt(\"ATI\");\nawait port.disableMux();                      \u002F\u002F CLD: the modem returns to AT mode\n",[126,935,936,955,985,1011,1035],{"__ignoreMap":157},[161,937,938,940,942,944,947,950,952],{"class":163,"line":164},[161,939,416],{"class":179},[161,941,183],{"class":171},[161,943,186],{"class":175},[161,945,946],{"class":189},"enableMux",[161,948,949],{"class":171},"()",[161,951,916],{"class":175},[161,953,954],{"class":214},"                       \u002F\u002F sends AT+CMUX=0,0,5,31,10,2 and opens DLCI 0\n",[161,956,957,959,962,964,966,968,970,973,975,978,980,982],{"class":163,"line":211},[161,958,168],{"class":167},[161,960,961],{"class":171}," at ",[161,963,176],{"class":175},[161,965,180],{"class":179},[161,967,183],{"class":171},[161,969,186],{"class":175},[161,971,972],{"class":189},"openMuxChannel",[161,974,193],{"class":171},[161,976,977],{"class":440},"1",[161,979,205],{"class":171},[161,981,916],{"class":175},[161,983,984],{"class":214},"      \u002F\u002F a SerialPort for DLCI 1 (1..=63)\n",[161,986,987,989,992,994,996,998,1000,1002,1004,1007,1009],{"class":163,"line":218},[161,988,168],{"class":167},[161,990,991],{"class":171}," data ",[161,993,176],{"class":175},[161,995,180],{"class":179},[161,997,183],{"class":171},[161,999,186],{"class":175},[161,1001,972],{"class":189},[161,1003,193],{"class":171},[161,1005,1006],{"class":440},"2",[161,1008,205],{"class":171},[161,1010,208],{"class":175},[161,1012,1013,1015,1018,1020,1022,1024,1026,1029,1031,1033],{"class":163,"line":224},[161,1014,416],{"class":179},[161,1016,1017],{"class":171}," at",[161,1019,186],{"class":175},[161,1021,190],{"class":189},[161,1023,193],{"class":171},[161,1025,196],{"class":175},[161,1027,1028],{"class":199},"ATI",[161,1030,196],{"class":175},[161,1032,205],{"class":171},[161,1034,208],{"class":175},[161,1036,1037,1039,1041,1043,1046,1048,1050],{"class":163,"line":477},[161,1038,416],{"class":179},[161,1040,183],{"class":171},[161,1042,186],{"class":175},[161,1044,1045],{"class":189},"disableMux",[161,1047,949],{"class":171},[161,1049,916],{"class":175},[161,1051,1052],{"class":214},"                      \u002F\u002F CLD: the modem returns to AT mode\n",[1054,1055,1056,1066,1083,1086,1089,1092,1112,1125,1134,1137,1145],"ul",{},[1057,1058,1059,1062,1063,1065],"li",{},[126,1060,1061],{},"enableMux({ command?, timeoutMs? })"," fails if the modem answers ",[126,1064,236],{}," or does\nnot acknowledge the control channel.",[1057,1067,1068,1069,1072,1073,237,1075,129,1078,749,1081,186],{},"Virtual channels are paths like ",[126,1070,1071],{},"\u002Fdev\u002FttyUSB0#dlci=2"," and support ",[126,1074,190],{},[126,1076,1077],{},"exchange",[126,1079,1080],{},"write",[126,1082,822],{},[1057,1084,1085],{},"Closing the physical port closes its channels and sends CLD.",[1057,1087,1088],{},"Frames carry at most 31 bytes (the 27.010 default N1); larger writes are split.",[1057,1090,1091],{},"After each channel's UA the plugin sends MSC (RTC, RTR, DV set) on DLCI 0. The\nmodem's own control commands (PN, PSC, TEST, MSC, RPN, RLS, FCon, FCoff, CLD) are\nanswered by echoing them; any other command gets NSC (27.010 §5.4.6.3.8).",[1057,1093,1094,1095,1098,1099,1102,1103,1105,1106,1109,1110,186],{},"Opening a channel: when the ",[126,1096,1097],{},"AT+CMUX"," command gives T1 or N2 (5th and 6th\nparameters, T1 in 10 ms units; defaults 100 ms and 3), SABM is resent every T1, at\nmost N2 times, and the whole wait is ",[126,1100,1101],{},"max(timeout, T1 × (N2 + 1))",", the last try\ngetting what is left. Without them one SABM is sent and its UA gets the whole\ntimeout, as in 4.x. (The default ",[126,1104,946],{}," command gives T1 = 10, N2 = 2.) The\ntimeout is ",[126,1107,1108],{},"max(timeoutMs, 500 ms)"," for the control channel (DLCI 0) and a fixed\n3 s for ",[126,1111,972],{},[1057,1113,1114,1115,1117,1118,1121,1122,1124],{},"If the modem closes a channel (DISC, answered with UA, or DM), its ",[126,1116,822],{}," gets\n",[126,1119,1120],{},"disconnect"," with the channel path and writes on it fail; the other channels stay\nopen. Re-open it with ",[126,1123,972],{}," (old watches on it are dropped; start a new\none).",[1057,1126,1127,1128,1130,1131,1133],{},"If the modem leaves multiplexer mode (DISC or DM on DLCI 0, or CLD from the modem),\nevery channel watch gets ",[126,1129,1120],{},", channel writes fail, and the physical port is\na plain port again (",[126,1132,946],{}," works again).",[1057,1135,1136],{},"Flow control: while the modem holds FCoff (every channel) or an MSC with FC set\n(that channel), a channel write waits; when it ends the write goes out, after the\nwrite timeout (below) the write fails with \"CMUX flow control off\" and is not sent\nlater. A write waiting for a channel that is closed meanwhile fails at once.",[1057,1138,1139,1141,1142,1144],{},[126,1140,1045],{}," waits up to T2 (7th ",[126,1143,1097],{}," parameter, default 300 ms) for the\nCLD response, without blocking calls on other ports.",[1057,1146,1147],{},"A channel write gets a timeout from its wire time at the port's baud rate, as\nplain-port writes do.",[122,1149,1150],{},"Tested against a Quectel M26.",[1152,1153,1154],"style",{},"html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B8