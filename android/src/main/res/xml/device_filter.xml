<?xml version="1.0" encoding="utf-8"?>
<!--
  USB_DEVICE_ATTACHED filter injected into the app's activity by the plugin.
  Keep it in sync with crates/android-usb-serial/src/probe.rs.
  Android parses ids as decimal unless they start with 0x; an unparsable id is
  ignored and turns the row into a wildcard, so always write 0x-prefixed hex.
  No catch-all <usb-device />: that would offer the app for every USB device.
-->
<resources>
    <!-- FTDI: FT232R, FT2232, FT4232, FT232H, FT-X -->
    <usb-device vendor-id="0x0403" product-id="0x6001" />
    <usb-device vendor-id="0x0403" product-id="0x6010" />
    <usb-device vendor-id="0x0403" product-id="0x6011" />
    <usb-device vendor-id="0x0403" product-id="0x6014" />
    <usb-device vendor-id="0x0403" product-id="0x6015" />

    <!-- Silicon Labs CP210x: CP2102/CP2102N/CP2104, CP2105, CP2108 -->
    <usb-device vendor-id="0x10C4" product-id="0xEA60" />
    <usb-device vendor-id="0x10C4" product-id="0xEA70" />
    <usb-device vendor-id="0x10C4" product-id="0xEA71" />

    <!-- Prolific PL2303 (legacy, HXN/GC/GB/GT/GL/GE/GS) -->
    <usb-device vendor-id="0x067B" product-id="0x2303" />
    <usb-device vendor-id="0x067B" product-id="0x23A3" />
    <usb-device vendor-id="0x067B" product-id="0x23B3" />
    <usb-device vendor-id="0x067B" product-id="0x23C3" />
    <usb-device vendor-id="0x067B" product-id="0x23D3" />
    <usb-device vendor-id="0x067B" product-id="0x23E3" />
    <usb-device vendor-id="0x067B" product-id="0x23F3" />

    <!-- WCH CH340 / CH341 -->
    <usb-device vendor-id="0x1A86" product-id="0x7523" />
    <usb-device vendor-id="0x1A86" product-id="0x5523" />

    <!-- Chrome OS Closed Case Debugging (Cr50) -->
    <usb-device vendor-id="0x18D1" product-id="0x5014" />

    <!-- Unisoc GSM modems -->
    <usb-device vendor-id="0x1782" product-id="0x4D10" />
    <usb-device vendor-id="0x1782" product-id="0x4D12" />

    <!-- Any CDC-ACM device (Arduino, RP2040, STM32 VCP, ESP32-S2/S3, modems):
         class 2 matches the device class or any interface's class. -->
    <usb-device class="2" />
</resources>
