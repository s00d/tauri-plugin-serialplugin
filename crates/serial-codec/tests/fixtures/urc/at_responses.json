  },
  {
   "source": "modemmanager/src/tests/test-modem-helpers.c:284",
   "license": "GPL-2.0-or-later",
   "input": {
    "response": "+CMGL: 0,1,,147\r\"
   },
   "expected": {
    "messages": [
     {
      "index": 0,
      "status": 1,
      "pdu": ""
     }
    ]
   },
   "name": "test_cmgl_response_generic",
   "note": "PDU mode +CMGL; parser matches results by index (order-insensitive), asserts stat and pdu"
  },
  {
   "source": "python-gsmmodem/test/test_modem.py:1788",
   "license": "LGPL-3.0-or-later",
   "input": {
    "command": "AT+CMGL=\"ALL\"",
    "mode": "text",
    "lines": [
     "+CMGL: 0,\"REC UNREAD\",\"+10000000001\",,\"13/01/28,14:51:42+08\"",
     "Hello raspberry pi",
     "+CMGL: 1,\"REC READ\",\"+10000000003\",,\"13/02/07,01:31:44+08\"",
     "New and here to stay! Don't just recharge SUPACHARGE and get your recharged airtime+FREE CellC to CellC mins & SMSs+Free data to use anytime. T&C apply. Cell C",
     "+CMGL: 2,\"REC READ\",\"+10000000002\",,\"13/02/07,06:24:02+08\"",
     "Example Bank: Your accounts are no longer compliant. Please bring ID & proof of residence to any branch to reactivate your accounts. Queries? 0000000000.",
     "OK"
    ]
   },
   "expected": {
    "messages": [
     {
      "number": "+10000000001",
      "status": {
       "const": "Sms.STATUS_RECEIVED_UNREAD",
       "value": 0
      },
      "time": "2013-01-28T14:51:42+02:00",
      "text": "Hello raspberry pi"
     },
     {
      "number": "+10000000003",
      "status": {
       "const": "Sms.STATUS_RECEIVED_READ",
       "value": 1
      },
      "time": "2013-02-07T01:31:44+02:00",
      "text": "New and here to stay! Don't just recharge SUPACHARGE and get your recharged airtime+FREE CellC to CellC mins & SMSs+Free data to use anytime. T&C apply. Cell C"
     },
     {
      "number": "+10000000002",
      "status": {
       "const": "Sms.STATUS_RECEIVED_READ",
       "value": 1
      },
      "time": "2013-02-07T06:24:02+02:00",
      "text": "Example Bank: Your accounts are no longer compliant. Please bring ID & proof of residence to any branch to reactivate your accounts. Queries? 0000000000."
     }
    ]
   },
   "name": "test_listStoredSms_text",
   "note": "ALL response = REC UNREAD list + REC READ list (test concatenates them). Filter counts asserted: REC UNREAD 1, REC READ 2, STO SENT 0, STO UNSENT 0. Phone numbers replaced with fakes.",
   "pii_phone": [
    "+10000000001",
    "+10000000002"
   ]
  }
 ],
